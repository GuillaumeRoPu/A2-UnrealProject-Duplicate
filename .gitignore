# =========================
# Unreal Engine
# =========================

# Generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Plugin generated folders
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Optional Unreal folders
Collections/
Developers/

# =========================
# IDE / Editor files
# =========================

# Visual Studio
.vs/
.vsconfig

# VSCode
.vscode/

# Rider / JetBrains
.idea/

# Generated project files
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# User-specific files
*.user
*.userosscache
*.sln.DotSettings.user

# =========================
# Compiled / Binary files
# =========================

# Object files
*.slo
*.lo
*.o
*.obj

# Precompiled headers
*.gch
*.pch

# Dynamic libraries
*.so
*.dylib
*.dll

# Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Fortran modules
*.mod

# =========================
# Build files
# =========================

# Ignore packaged builds
Build/*

# Keep important Unreal build files
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# =========================
# Source Art
# =========================

# Optional source assets
SourceArt/**/*.png
SourceArt/**/*.tga

# =========================
# Unreal generated map data
# =========================

# Ignore if you want lighter repos
# Remove this line if lighting issues appear
# *_BuiltData.uasset

# =========================
# Logs / Crash dumps
# =========================

*.log
*.dmp

# =========================
# macOS
# =========================

.DS_Store
.AppleDouble
.LSOverride

# Apple thumbnails
._*

# macOS folders
.Spotlight-V100
.Trashes

# =========================
# Windows
# =========================

Thumbs.db
ehthumbs.db
Desktop.ini

# =========================
# Temp / backup
# =========================

*.tmp
*.temp
*.bak